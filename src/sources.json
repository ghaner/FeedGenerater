{
  "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "timeout": 40,
  "sources": [
    {
      "name": "seedog",
      "parser": "seedog",
      "url": "https://seedog.cc/?order=update",
      "base": "https://seedog.cc",
      "feed_title": "SeedHub 最近更新（影视&动漫）",
      "feed_desc": "SeedHub 影视&动漫分享站，按「最近更新」排序的影片 RSS 订阅源（本地生成，绕开 Cloudflare）。",
      "ttl": 60,
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><p style=\"margin:0 0 6px;color:#555;\">{cats}</p><p style=\"margin:0;color:#888;\">豆瓣评分: <a href=\"{douban}\" target=\"_blank\">{rate}</a></p><div style=\"clear:both;\"></div></div>"
    },
    {
      "name": "yszzq",
      "parser": "generic",
      "url": "https://www.yszzq.com/ziyuan/web/19_0_0_0_newstime_0.html",
      "base": "https://www.yszzq.com",
      "feed_title": "影视站长圈 资源站官网 最近更新",
      "feed_desc": "影视站长圈（yszzq.com）影视资源采集官网列表，按「最新采集」排序的 RSS 订阅源（本地生成）。",
      "ttl": 60,
      "item_block": "(<a href=\"https://www\\.yszzq\\.com/ziyuan/web/\\d+\\.html\"[^>]*>.*?</a>)",
      "fields": {
        "link":   {"pattern": "href=\"([^\"]+)\"", "group": 1, "abs": true},
        "poster": {"pattern": "<img[^>]*src=\"([^\"]+)\"", "group": 1, "abs": true},
        "title":  {"pattern": "<h2>(?:<span[^>]*>.*?</span>)?\\s*(.*?)</h2>", "group": 1, "strip_tags": true},
        "meta":   {"pattern": "<p>(.*?)</p>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><div style=\"clear:both;\"></div></div>"
    },
    {
      "name": "kkys14",
      "parser": "generic",
      "fetch": "browser",
      "enabled": false,
      "note": "【已暂停，暂不出源】目标页为 https://www.kkys14.com/label/new.html（用户指定），站点是 SPA + cdndefend JS 算力挑战：urllib 直接拿 HTTP 850 挑战页；已在生成器内置 fetch:\"browser\"（Playwright 跑 JS 过挑战）。本机实测：浏览器能过挑战并拿到渲染后 HTML（首页 81 条影片规则离线验证通过），但 fetch_browser 在生成器流程内多次返回未渲染空壳（0 条），SPA 内容等待时机未调通。故 enabled:false，不影响其他源。恢复时：先调通 fetch_browser 的 SPA 等待逻辑，再针对 label/new.html 重新抓真实 HTML 校正下方正则，最后改 true。",
      "wait_selector": "div.v-item",
      "settle": 6,
      "limit": 40,
      "url": "https://www.kkys14.com/",
      "base": "https://www.kkys14.com",
      "feed_title": "KKYS14 可可影视 最近更新",
      "feed_desc": "可可影视（kkys14.com）最近更新影片 RSS，浏览器抓取绕开 cdndefend JS 算力挑战。",
      "ttl": 60,
      "item_block": "<a href=\"[^\"]+\" class=\"v-item\">.*?</a>",
      "fields": {
        "link":   {"pattern": "<a href=\"([^\"]+)\" class=\"v-item\">", "group": 1, "abs": true},
        "poster": {"pattern": "src=\"(https?://[^\"]*/(?:vod|cover)/[^\"]+)\"", "group": 1, "abs": true},
        "title":  {"pattern": "<div class=\"v-item-title\">([^<]+)</div>", "group": 1, "strip_tags": true},
        "meta":   {"pattern": "<div class=\"v-item-top-left\">\\s*<span>([^<]*)</span>", "group": 1, "strip_tags": true},
        "cats":   {"pattern": "<div class=\"v-item-bottom\">\\s*<span>([^<]*)</span>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><p style=\"margin:0 0 6px;color:#888;\">{cats}</p><div style=\"clear:both;\"></div></div>"
    }
  ]
}
