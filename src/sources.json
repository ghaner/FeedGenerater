{
  "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "timeout": 40,
  "sources": [
    {
      "name": "seedog",
      "parser": "seedog",
      "url": "https://seedog.cc/?order=update",
      "base": "https://seedog.cc",
      "feed_title": "SeedHub 最近更新（影视&动漫）",
      "feed_desc": "SeedHub 影视&动漫分享站，按「最近更新」排序的影片 RSS 订阅源（本地生成，绕开 Cloudflare）。",
      "ttl": 60,
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><p style=\"margin:0 0 6px;color:#555;\">{cats}</p><p style=\"margin:0;color:#888;\">豆瓣评分: <a href=\"{douban}\" target=\"_blank\">{rate}</a></p><div style=\"clear:both;\"></div></div>"
    },
    {
      "name": "yszzq",
      "parser": "generic",
      "url": "https://www.yszzq.com/ziyuan/web/19_0_0_0_newstime_0.html",
      "base": "https://www.yszzq.com",
      "feed_title": "影视站长圈 资源站官网 最近更新",
      "feed_desc": "影视站长圈（yszzq.com）影视资源采集官网列表，按「最新采集」排序的 RSS 订阅源（本地生成）。",
      "ttl": 60,
      "item_block": "(<a href=\"https://www\\.yszzq\\.com/ziyuan/web/\\d+\\.html\"[^>]*>.*?</a>)",
      "fields": {
        "link":   {"pattern": "href=\"([^\"]+)\"", "group": 1, "abs": true},
        "poster": {"pattern": "<img[^>]*src=\"([^\"]+)\"", "group": 1, "abs": true},
        "title":  {"pattern": "<h2>(?:<span[^>]*>.*?</span>)?\\s*(.*?)</h2>", "group": 1, "strip_tags": true},
        "meta":   {"pattern": "<p>(.*?)</p>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><div style=\"clear:both;\"></div></div>"
    },
    {
      "name": "yszzq_api",
      "parser": "generic",
      "url": "https://www.yszzq.com/ziyuan/api/20_0_0_0_newstime_0.html",
      "base": "https://www.yszzq.com",
      "feed_title": "影视站长圈 采集接口 最近更新",
      "feed_desc": "影视站长圈（yszzq.com）影视资源采集接口列表，按「最新采集」排序的 RSS 订阅源（本地生成，已自动过滤「失效」接口）。",
      "ttl": 60,
      "exclude": {"field": "status", "values": ["失效"]},
      "item_block": "(<a href=\"https://www\\.yszzq\\.com/ziyuan/api/\\d+\\.html\"[^>]*>.*?</a>)",
      "fields": {
        "link":   {"pattern": "href=\"([^\"]+)\"", "group": 1, "abs": true},
        "title":  {"pattern": "<h2>(?:<span[^>]*>.*?</span>)?\\s*(.*?)</h2>", "group": 1, "strip_tags": true},
        "status": {"pattern": "<h2><span[^>]*>(.*?)</span>", "group": 1, "strip_tags": true},
        "cms":    {"pattern": "<p>(.*?)</p>", "group": 1, "strip_tags": true},
        "cats":   {"pattern": "<p>.*?</p>\\s*<p>(.*?)</p>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b><span style=\"color:#888;font-size:12px;\"> {status}</span></p><p style=\"margin:0 0 6px;color:#555;\">支持 CMS：{cms}</p><p style=\"margin:0;color:#888;\">分类：{cats}</p></div>"
    },
    {
      "name": "yszzq_jiexi",
      "parser": "generic",
      "url": "https://www.yszzq.com/ziyuan/jiexi/21_0_0_newstime_0.html",
      "base": "https://www.yszzq.com",
      "feed_title": "影视站长圈 解析接口 最近更新",
      "feed_desc": "影视站长圈（yszzq.com）影视解析接口列表，按「最新排序」的 RSS 订阅源（本地生成）。",
      "ttl": 60,
      "exclude": {"field": "status", "values": ["失效"]},
      "item_block": "(<article[^>]*>\\s*<a href=\"https://www\\.yszzq\\.com/ziyuan/jiexi/\\d+\\.html\">.*?</a></article>)",
      "fields": {
        "link":   {"pattern": "href=\"([^\"]+)\"", "group": 1, "abs": true},
        "title":  {"pattern": "<h2>(?:<span[^>]*>.*?</span>)?\\s*(.*?)</h2>", "group": 1, "strip_tags": true},
        "status": {"pattern": "<h2><span[^>]*>(.*?)</span>", "group": 1, "strip_tags": true},
        "fee":    {"pattern": "<p>(.*?)</p>", "group": 1, "strip_tags": true},
        "api":    {"pattern": "<p>.*?</p>\\s*<p>(.*?)</p>", "group": 1, "strip_tags": true},
        "fmt":    {"pattern": "<p>.*?</p>\\s*<p>.*?</p>\\s*<p>(.*?)</p>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b><span style=\"color:#888;font-size:12px;\"> {status}</span></p><p style=\"margin:0 0 6px;color:#555;\">解析地址：<code>{api}</code></p><p style=\"margin:0;color:#888;\">{fee} · {fmt}</p></div>"
    },
    {
      "name": "cctv_jkzl",
      "parser": "json",
      "url": "https://api.cntv.cn/NewVideo/getVideoListByColumn?id=TOPC1451557646802924&n=50&sort=desc&p=1&d=&mode=0&serviceId=tvcctv",
      "base": "https://tv.cctv.com",
      "feed_title": "CCTV《健康之路》最新节目",
      "feed_desc": "中央电视台《健康之路》栏目最新节目列表（CCTV 官方栏目接口，本地生成，含播出时间与节目简介）。",
      "feed_link": "https://tv.cctv.com/lm/jkzl/index.shtml",
      "ttl": 60,
      "tz": "+0800",
      "items_path": "data.list",
      "fields": {
        "link":   {"key": "url", "abs": true},
        "title":  {"key": "title", "strip_tags": true},
        "poster": {"key": "image", "abs": true},
        "brief":  {"key": "brief", "strip_tags": true},
        "length": {"key": "length"},
        "date":   {"key": "time", "date": "%Y-%m-%d %H:%M:%S"}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:160px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{brief}</p><p style=\"margin:0;color:#888;\">播出：{date} · 时长：{length}</p><div style=\"clear:both;\"></div></div>"
    },
    {
      "name": "kkys14",
      "parser": "generic",
      "enabled": true,
      "note": "cookie 通道：cdndefend 挑战发放静态 cookie，带该 cookie 直连即 200（实测 1.06 秒 / 24 条，不校验 UA）。站点有反调试跳转（约 3.9 秒跳百度），故不走 DOM 渲染。cookie 被轮换时 cookie_recovery 会用浏览器自动刷新一次再重连。",
      "limit": 40,
      "url": "https://www.kkys14.com/label/new.html",
      "base": "https://www.kkys14.com",
      "headers": {"Cookie": "${KKYS14_COOKIE}"},
      "cookie_recovery": true,
      "cookie_name": "cdndefend_js_cookie",
      "cookie_wait": 4,
      "feed_title": "KKYS14 可可影视 最近更新",
      "feed_desc": "可可影视（kkys14.com）今日更新影片 RSS，用静态 cookie 直连绕开 cdndefend JS 挑战。",
      "ttl": 60,
      "item_block": "<a href=\"[^\"]+\" class=\"v-item\">.*?</a>",
      "fields": {
        "link":   {"pattern": "<a href=\"([^\"]+)\" class=\"v-item\">", "group": 1, "abs": true},
        "poster": {"pattern": "data-original=\"(/vod\\d+/vod/[^\"]+)\"", "group": 1, "abs": true, "base": "https://vres.wkcyvs.cn"},
        "title":  {"pattern": "<div class=\"v-item-title\">([^<]+)</div>", "group": 1, "strip_tags": true},
        "meta":   {"pattern": "<div class=\"v-item-top-left\">\\s*<span>([^<]*)</span>", "group": 1, "strip_tags": true},
        "cats":   {"pattern": "<div class=\"v-item-bottom\">\\s*<span>([^<]*)</span>", "group": 1, "strip_tags": true}
      },
      "template": "<div style=\"font-family:sans-serif;line-height:1.6;\"><a href=\"{link}\" target=\"_blank\"><img src=\"{poster}\" alt=\"{title}\" style=\"max-width:120px;float:left;margin:0 12px 8px 0;border-radius:6px;\"></a><p style=\"margin:0 0 6px;\"><b><a href=\"{link}\" target=\"_blank\">{title}</a></b></p><p style=\"margin:0 0 6px;color:#555;\">{meta}</p><p style=\"margin:0 0 6px;color:#888;\">{cats}</p><div style=\"clear:both;\"></div></div>"
    }
  ]
}
